{
  "name": "@hyav/pi-search",
  "version": "0.1.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyav/pi-search.git"
  },
  "description": "LLM-driven web search and content extraction extension for Pi — built-in Tavily, AnySearch, and Jina providers.",
  "type": "module",
  "main": "./index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "search",
    "web-search",
    "tavily",
    "anysearch",
    "jina"
  ],
  "author": "hyav",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src/",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@types/node": "22.20.1",
    "tsx": "4.23.11",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && npm run typecheck",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "artifact:check": "node scripts/check-package.mjs",
    "release:check": "node scripts/check-release.mjs",
    "release:notes": "node scripts/write-release-notes.mjs",
    "prepublishOnly": "npm run audit:runtime && npm run audit:all && npm run release:check && npm run check && npm test && npm run artifact:check"
  },
  "homepage": "https://github.com/hyav/pi-search#readme",
  "bugs": {
    "url": "https://github.com/hyav/pi-search/issues"
  }
}
